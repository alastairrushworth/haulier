# Copy to .env and edit. Every setting is optional; the defaults in
# src/haulier/config.py are what the code runs with when this file is absent.
# Real secrets never go in here — .env is gitignored, .env.example is not.

# Where captured releases, text dumps, manifests and digests live.
HAULIER_DATA_DIR=data

# Goes in the User-Agent so GOV.UK can reach a human (spec §8.2). Be honest.
HAULIER_CONTACT_EMAIL=you@example.org

# Where a data subject asks to be removed (PLAN §2.11, spec §8.3). Rendered in
# every digest footer. Defaults to HAULIER_CONTACT_EMAIL when unset, so the
# objection route works from the first send.
HAULIER_OBJECTION_EMAIL=

# Published privacy notice. While empty the footer says the notice is available
# on request rather than linking somewhere that 404s.
HAULIER_PRIVACY_NOTICE_URL=

# Politeness. Raise the delay rather than lowering it.
HAULIER_REQUEST_DELAY_SECONDS=1.0
HAULIER_REQUEST_TIMEOUT_SECONDS=60.0
HAULIER_HTTP_RETRIES=3
